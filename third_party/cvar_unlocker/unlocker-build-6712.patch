+++ b/shutdown_lifecycle_tests.cpp
@@ -0,0 +1,158 @@
+
+#include <cstdio>
+#include <stdexcept>
+using CreateInterfaceFn = void*(*)(const char*,int*);
+struct IAppSystem {};
+static void check(bool value,const char* reason) { if(!value) throw std::runtime_error(reason); }
+struct ConCommand { bool valid=false; bool IsValidRef()const{return valid;} void InvalidateRef(){valid=false;} };
+static int callbacks=0,lateCallbacks=0,originalDisconnects=0;
+static bool registryAlive=true,connectResult=true,adapterValid=true;
+static bool DollyAdaptCvarInterface(){return adapterValid;}
+struct Registry { void UnregisterConCommandCallbacks(const ConCommand&) { if(registryAlive) ++callbacks; else ++lateCallbacks; } };
+static Registry registry;
+static Registry *g_pCVar=nullptr,*cvar=nullptr;
+static ConCommand cvar_unhide_command,cvarlist_md_command;
+struct ConnectionRegistration_t { void *m_ppGlobalStorage; int m_nConnectionPhase; };
+static int s_nConnectionCount=0,s_nRegistrationCount=0;
+static ConnectionRegistration_t s_pConnectionRegistration[2];
+static bool g_UnlockerInterfacesConnected=false;
+static constexpr unsigned long long FCVAR_RELEASE=1,FCVAR_GAMEDLL=2;
+static void ConnectInterfaces(CreateInterfaceFn*,int) {
+ g_pCVar=cvar=&registry;
+ s_pConnectionRegistration[0]={&g_pCVar,0};s_pConnectionRegistration[1]={&cvar,0};
+ s_nConnectionCount=1;s_nRegistrationCount=2;
+}
+static void ConVar_Register(unsigned long long) { cvar_unhide_command.valid=true;cvarlist_md_command.valid=true; }
+static void ConVar_Unregister() {} // The pinned implementation only resets its registered flag.
+static bool originalConnect(IAppSystem*,CreateInterfaceFn) {return connectResult;}
+static void originalDisconnect(IAppSystem*) {++originalDisconnects;}
+static auto g_pfnServerConfigConnect=originalConnect;
+static auto g_pfnServerConfigDisconnect=originalDisconnect;
+
+
+void UnRegisterConCommand( ConCommand *cmd )
+{
+	if(cmd->IsValidRef())
+	{
+		if(g_pCVar)
+			g_pCVar->UnregisterConCommandCallbacks( *cmd );
+
+		cmd->InvalidateRef();
+	}
+}
+
+static void UnregisterOwnedCommand(ConCommand& command)
+{
+	if (!command.IsValidRef())
+		return;
+	if (g_pCVar)
+		g_pCVar->UnregisterConCommandCallbacks(command);
+	command.InvalidateRef();
+}
+
+void UnregisterUnlockerCommands()
+{
+	UnregisterOwnedCommand(cvar_unhide_command);
+	UnregisterOwnedCommand(cvarlist_md_command);
+}
+
+void DisconnectInterfaces()
+{
+	if (--s_nConnectionCount >= 0)
+	{
+		for (int i = 0; i < s_nRegistrationCount; i++)
+		{
+			ConnectionRegistration_t &reg = s_pConnectionRegistration[i];
+			if (reg.m_nConnectionPhase == s_nConnectionCount)
+				*(void **)reg.m_ppGlobalStorage = NULL;
+		}
+	}
+}
+
+void BaselineDisconnectInterfaces()
+{
+	if (--s_nConnectionCount >= 0)
+	{
+		for (int i = 0; i < s_nRegistrationCount; i++)
+		{
+			ConnectionRegistration_t &reg = s_pConnectionRegistration[i];
+			if (reg.m_nConnectionPhase == s_nConnectionCount)
+				reg.m_ppGlobalStorage = NULL;
+		}
+	}
+}
+
+bool Connect(IAppSystem* appSystem, CreateInterfaceFn factory)
+{
+	const bool result = g_pfnServerConfigConnect(appSystem, factory);
+	if (!result)
+		return false;
+
+	ConnectInterfaces(&factory, 1);
+	if (!DollyAdaptCvarInterface())
+	{
+		DisconnectInterfaces();
+		return false;
+	}
+
+	ConVar_Register(FCVAR_RELEASE | FCVAR_GAMEDLL);
+	g_UnlockerInterfacesConnected = true;
+
+	return result;
+}
+
+void Disconnect(IAppSystem* appSystem)
+{
+	if (g_UnlockerInterfacesConnected)
+	{
+		g_UnlockerInterfacesConnected = false;
+		UnregisterUnlockerCommands();
+		ConVar_Unregister();
+		DisconnectInterfaces();
+	}
+	g_pfnServerConfigDisconnect(appSystem);
+}
+
+
+static void reset() {
+ callbacks=lateCallbacks=originalDisconnects=0;registryAlive=connectResult=adapterValid=true;
+ g_pCVar=cvar=nullptr;g_UnlockerInterfacesConnected=false;
+ s_nConnectionCount=s_nRegistrationCount=0;
+ cvar_unhide_command.valid=cvarlist_md_command.valid=false;
+}
+static void lateDestructors() {
+ registryAlive=false;
+ // Exact pinned SDK routine called by each command's static destructor.
+ UnRegisterConCommand(&cvar_unhide_command);UnRegisterConCommand(&cvarlist_md_command);
+}
+int main() {
+ try {
+  IAppSystem system;
+  reset();check(Connect(&system,nullptr),"normal connect failed");
+  Disconnect(&system);
+  check(callbacks==2,"owned callbacks must detach before teardown");
+  check(g_pCVar==nullptr && cvar==nullptr,"SDK globals not cleared");
+  check(!cvar_unhide_command.valid && !cvarlist_md_command.valid,"references not invalidated");
+  lateDestructors();check(lateCallbacks==0,"late command accessed destroyed registry");
+  Disconnect(&system);check(callbacks==2 && originalDisconnects==2,"duplicate cleanup was not idempotent");
+  reset();connectResult=false;
+  check(!Connect(&system,nullptr),"failed parent connect accepted");Disconnect(&system);lateDestructors();
+  check(callbacks==0 && lateCallbacks==0 && s_nConnectionCount==0,"failed connect acquired cleanup state");
+  reset();adapterValid=false;
+  check(!Connect(&system,nullptr),"failed adapter accepted");
+  check(!g_pCVar && !cvar && !g_UnlockerInterfacesConnected,"failed adapter leaked interfaces");
+  Disconnect(&system);lateDestructors();
+  check(callbacks==0 && lateCallbacks==0 && s_nConnectionCount==0,"failed adapter acquired registry callbacks");
+  reset();Connect(&system,nullptr);cvarlist_md_command.InvalidateRef();Disconnect(&system);lateDestructors();
+  check(callbacks==1 && lateCallbacks==0,"invalid reference touched registry");
+  reset();Connect(&system,nullptr);g_pCVar=nullptr;Disconnect(&system);lateDestructors();
+  check(callbacks==0 && lateCallbacks==0,"missing interface cleanup not safe");
+  // Confirm the simulated registry catches the original SDK pointer bug and
+  // the upstream absence of early command cleanup, rather than merely passing.
+  reset();Connect(&system,nullptr);BaselineDisconnectInterfaces();
+  check(g_pCVar!=nullptr && cvar!=nullptr,"baseline bug no longer reproduced");
+  lateDestructors();check(lateCallbacks==2,"baseline late access was not detected");
+  std::puts("passed: lifecycle ordering, late destructors, repeated cleanup, failed connect, invalid reference, missing interface, baseline failure");
+  return 0;
+ } catch(const std::exception& e) {std::fprintf(stderr,"FAILED: %s\n",e.what());return 1;}
+}
